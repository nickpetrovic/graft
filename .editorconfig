root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{sh,json,yml,yaml,plist,csproj,props,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.patch]
trim_trailing_whitespace = false

[{Sources/GraftMerge,Tests/GraftMergeTests}/**.cs]
dotnet_diagnostic.IDE0005.severity = warning
csharp_new_line_before_open_brace = types,methods,properties,accessors,local_functions
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

[Makefile]
indent_style = tab
