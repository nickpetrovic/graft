@@ -0,0 +1,17 @@
+namespace TkSharp.Core;
+
+public static class TkSystemFiles
+{
+    public static bool IsMetadata(string path)
+    {
+        var parts = path.Replace('\\', '/').Split('/', StringSplitOptions.RemoveEmptyEntries);
+        if (parts.Length == 0) {
+            return false;
+        }
+
+        var name = parts[^1];
+        return name.StartsWith("._", StringComparison.Ordinal)
+            || name is ".DS_Store" or "Thumbs.db" or "desktop.ini"
+            || parts.Contains("__MACOSX");
+    }
+}
